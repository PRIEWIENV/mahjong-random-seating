[Unit]
Description=Run the mahjong seating finalisation job

[Timer]
# Every minute, not every five.
#
# The roll taken at the cutoff has to be published and timestamped INSIDE
# reveal_gap_seconds, while the beacon that opens the ciphertexts does not yet exist
# (PROTOCOL.md section 9). A five-minute cadence against a ten-minute interval spends
# half of it waiting to notice, and against a shorter interval would miss it
# altogether — publishing the roll after the key is out proves nothing.
#
# A no-op until submission_cutoff_utc. After the cutoff it takes the snapshot and
# then keeps retrying until drand publishes the target round, which is also the
# recovery path for a drand outage.
OnCalendar=*:*:00
Persistent=true
AccuracySec=15s

[Install]
WantedBy=timers.target
